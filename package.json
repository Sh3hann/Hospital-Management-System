{
  "name": "hospital-management-system",
  "version": "2.0.0",
  "description": "MediCore Hospital Management System — Node.js + MySQL",
  "main": "backend/index.js",
  "scripts": {
    "start": "node backend/index.js",
    "dev": "nodemon backend/index.js",
    "migrate": "node backend/db/migrate.js",
    "seed": "node backend/db/seed.js && node backend/db/seed-demo-accounts.js && node backend/db/seed-records.js",
    "seed:records": "node backend/db/seed-records.js",
    "seed:comprehensive": "node backend/db/seed-comprehensive.js",
    "backup": "node -e \"require('./backend/db/backup').manualBackup('cli').then(r=>console.log(r))\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.24.3",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
