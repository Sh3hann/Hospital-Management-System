# ============================================
# HMS — Hospital Management System
# Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ─── Server ─────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── MySQL Database ──────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=hms_db

# ─── JWT Auth ────────────────────────────────
JWT_SECRET=hms_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=8h

# ─── Backup & Recovery ───────────────────────
BACKUP_DIR=./backups
BACKUP_RETAIN_DAYS=30
MYSQLDUMP_PATH=mysqldump
